<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <application android:icon="@mipmap/ic_launcher" android:label="Microbes" android:roundIcon="@mipmap/ic_launcher" android:supportsRtl="true">
        <activity android:name=".LauncherActivity" android:exported="true" android:label="Microbes" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".MicrobesWallpaperService" android:exported="true" android:label="Microbes" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter> <action android:name="android.service.wallpaper.WallpaperService" /> </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/microbes_wallpaper" />
        </service>
    </application>
</manifest>
